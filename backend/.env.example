# ═══════════════════════════════════════════════════════════
# Agentic PR Manager — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ── Application ──────────────────────────────────────────
APP_NAME="Agentic PR Manager"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-me-in-production
API_V1_PREFIX=/api/v1

# ── Database (Supabase PostgreSQL) ───────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project.supabase.co:5432/postgres
# For local Docker Compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_pr_manager

# ── Redis Cache ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For Upstash:
# REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# ── AWS Bedrock ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_IMAGE_MODEL_ID=amazon.titan-image-generator-v2:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── Cloudflare R2 (S3-Compatible) ────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=agentic-pr-manager
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Firebase Cloud Messaging ─────────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ── Scheduling ───────────────────────────────────────────
BATCH_GENERATION_CRON_HOUR=2
BATCH_GENERATION_CRON_MINUTE=30
DISPATCH_CRON_HOUR=6
DISPATCH_CRON_MINUTE=0
TIMEZONE=Asia/Kolkata
